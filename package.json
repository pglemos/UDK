{
  "name": "udk-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "verify": "node scripts/verify-workspace.mjs && node scripts/verify-packages.mjs",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "25.0.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.1",
    "prettier": "3.6.2",
    "turbo": "2.5.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}