{
  "name": "udk-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:workspace": "node scripts/verify-workspace.mjs"
  },
  "devDependencies": {
    "@types/node": "25.0.3",
    "eslint": "9.39.2",
    "prettier": "3.6.2",
    "turbo": "2.5.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
